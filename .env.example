# ==========================================
# KIZUNAFIT V1 - Environment Variables
# ==========================================

# ------------------------------------------
# Backend Variables
# ------------------------------------------
# Environment (development | production | test)
NODE_ENV=development

# Server Port (Required)
PORT=3000

# API Prefix (Required)
API_PREFIX=/api/v1

# MongoDB Connection String (Required)
MONGODB_URI=mongodb://localhost:27017/kizunafit

# Redis Connection String (Required)
REDIS_URL=redis://localhost:6379

# JWT Access Secret (Required, Min 16 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here

# JWT Refresh Secret (Required, Min 16 chars)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# JWT Expirations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Integration (Required for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Provider Configuration (Optional/Required based on env)
EMAIL_PROVIDER=smtp
EMAIL_DISPATCH_MODE=sync
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_password
SMTP_FROM=mohammednihal.dev@gmail.com

# BullMQ Queue Prefix
BULLMQ_PREFIX=kizunafit_queue

# WebRTC / Socket.IO
SOCKET_PORT=3001

# URLs and CORS
FRONTEND_URL=http://localhost:3002
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3002

# Logging
LOG_LEVEL=debug

# ------------------------------------------
# Frontend Variables
# ------------------------------------------
# Base URL for API requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# WebSockets URL
NEXT_PUBLIC_SOCKET_URL=ws://localhost:3001

# Application Identity
NEXT_PUBLIC_APP_NAME=KizunaFit
NEXT_PUBLIC_APP_ENV=development

# Frontend Cloudinary specific variables
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
